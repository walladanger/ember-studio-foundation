{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ember Studio",
  "version": "0.1.0",
  "identifier": "com.emberstudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ember Studio",
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
